# GitHub OAuth App credentials
# Create one at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Homepage URL: http://localhost:5173
# Authorization callback URL: http://localhost:3001/api/admin/auth/callback
ADMIN_GITHUB_CLIENT_ID=
ADMIN_GITHUB_CLIENT_SECRET=

# The GitHub username (login) that is allowed to access the admin panel (case-insensitive)
ADMIN_GITHUB_USERNAME=

# Secret for signing admin JWTs — generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=

# Firebase Service Account JSON
# Option A — paste the entire JSON object on a single line:
#   FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}
# Option B — provide a path to the downloaded .json file:
#   FIREBASE_SERVICE_ACCOUNT=/path/to/serviceAccountKey.json
# Option C — leave unset when running on Cloud Run / GCE (uses Application Default Credentials)
FIREBASE_SERVICE_ACCOUNT=

# URL where the frontend admin panel is hosted
# Development:  http://localhost:5173
# Production:   https://your-project.web.app
ADMIN_ORIGIN=http://localhost:5173

# Port for the admin server (default: 3001)
PORT=3001
