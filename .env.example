# Firebase configuration: copy this file to .env.local and fill in your values.
# Get these from: Firebase Console → Project Settings → Your apps → Web app → SDK setup and config

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# SHA-256 hash of your team passphrase. Remove or leave blank to disable the gate.
# Generate a new hash: node -e "require('crypto').createHash('sha256').update('YOUR_PASSPHRASE').digest('hex')"
VITE_ACCESS_CODE_HASH=

# ─── Admin panel (server/.env) ────────────────────────────────────────────────
# These go in server/.env; copy server/.env.example to server/.env and fill in.
# See server/.env.example for full documentation.
