rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /sessions/{shareId} {
      // shareId must be exactly 6 uppercase alphanumeric chars (our format)
      function validShareId() {
        return shareId.matches('^[A-HJ-NP-Z2-9]{6}$');
      }

      // Incoming document must have exactly the three expected fields
      function validShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['json', 'clientId', 'updatedAt'])
          && d.keys().hasAll(['json', 'clientId', 'updatedAt'])
          && d.json is string
          && d.json.size() < 2097152       // 2 MB max
          && d.clientId is string
          && d.clientId.size() > 0
          && d.clientId.size() <= 64
          && d.updatedAt is int
          && d.updatedAt > 0;
      }

      // Writes must carry a fresh timestamp (within 60 s of server time)
      function freshTimestamp() {
        return request.resource.data.updatedAt > request.time.toMillis() - 60000
          && request.resource.data.updatedAt < request.time.toMillis() + 5000;
      }

      allow read: if validShareId();
      allow write: if validShareId() && validShape() && freshTimestamp();

      // No other collections allowed
    }
  }
}
