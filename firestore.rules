rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /sessions/{shareId} {
      function validShareId() {
        return shareId.matches('^[A-HJ-NP-Z2-9]{6}$');
      }

      function validBase() {
        let d = request.resource.data;
        return d.keys().hasAll(['clientId', 'updatedAt'])
          && d.clientId is string
          && d.clientId.size() > 0
          && d.clientId.size() <= 64
          && d.updatedAt is int
          && d.updatedAt > 0;
      }

      function isPlain() {
        let d = request.resource.data;
        return d.keys().hasOnly(['json', 'clientId', 'updatedAt'])
          && d.json is string
          && d.json.size() < 2097152;
      }

      function isEncrypted() {
        let d = request.resource.data;
        return d.keys().hasOnly(['ciphertext', 'iv', 'salt', 'clientId', 'updatedAt'])
          && d.ciphertext is string
          && d.ciphertext.size() < 2097152
          && d.iv is string
          && d.iv.size() <= 32
          && d.salt is string
          && d.salt.size() <= 32;
      }

      function freshTimestamp() {
        return request.resource.data.updatedAt > request.time.toMillis() - 60000
          && request.resource.data.updatedAt < request.time.toMillis() + 5000;
      }

      allow read: if validShareId();
      allow write: if validShareId() && validBase() && (isPlain() || isEncrypted()) && freshTimestamp();
    }
  }
}
